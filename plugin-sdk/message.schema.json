{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isle.dev/schemas/plugin-message-v1.json",
  "title": "Isle plugin -> host message",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "activity.remove" },
        "id": { "type": "string", "minLength": 1, "maxLength": 96 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "activity"],
      "properties": {
        "type": { "const": "activity.upsert" },
        "activity": {
          "type": "object",
          "required": ["id", "title"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 96 },
            "kind": { "enum": ["metric", "status", "timer", "text", "media"] },
            "title": { "type": "string", "maxLength": 120 },
            "subtitle": { "type": "string", "maxLength": 200 },
            "glyph": { "type": "string", "maxLength": 8 },
            "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "progress": { "type": "number", "minimum": 0, "maximum": 1 },
            "value": { "type": "number" },
            "valueSuffix": { "type": "string", "maxLength": 16 },
            "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 },
            "pinned": { "type": "boolean" },
            "actions": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": ["id", "label"],
                "properties": {
                  "id": { "type": "string", "maxLength": 64 },
                  "label": { "type": "string", "maxLength": 80 },
                  "glyph": { "type": "string", "maxLength": 8 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
